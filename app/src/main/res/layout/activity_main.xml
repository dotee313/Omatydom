<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/user_dark"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="3dp"
        android:layout_weight="1">

        <!-- 0: world -->
        <LinearLayout
            android:id="@+id/worldPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brushHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_panel"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingBottom="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:text="الفرشاة: فحص — اضغط أي شيء لتقرأ شرحه."
                android:textColor="#FFFFF3E0"
                android:textSize="12sp" />

            <com.dotee313.omatydom.android.IslandView
                android:id="@+id/islandView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="96dp" />
        </LinearLayout>

        <!-- 1: people -->
        <LinearLayout
            android:id="@+id/peoplePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/people_header"
                android:background="@drawable/bg_bar"
                android:textColor="@color/user_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/peopleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 2: nature -->
        <LinearLayout
            android:id="@+id/naturePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="الطبيعة — القوانين، الأحياء الحيوية والموارد — اضغط أيقونة لتعرفها"
                android:background="@drawable/bg_bar"
                android:textColor="@color/user_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/natureList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 3: creatures -->
        <LinearLayout
            android:id="@+id/creaturesPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="المخلوقات — اضغط + لتطلق مخلوقًا جديدًا في الجزيرة"
                android:background="@drawable/bg_bar"
                android:textColor="@color/user_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/creatureList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 4: kingdoms -->
        <LinearLayout
            android:id="@+id/kingdomsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="الممالك — العشائر، الثقافة، الحروب، التقنيات والمراسيم"
                android:background="@drawable/bg_bar"
                android:textColor="@color/user_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_bar"
                android:orientation="horizontal"
                android:layoutDirection="rtl">

                <ImageButton
                    android:id="@+id/foundClanButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="تأسيس عشيرة"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/foundKingdomButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="تأسيس مملكة"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/researchButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="بحث تقني"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/warButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="إعلان حرب غزو"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/warTypeRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_bar"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tradeRouteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_panel"
                android:ellipsize="end"
                android:maxLines="2"
                android:padding="4dp"
                android:text="@string/trade_routes_initial"
                android:textColor="@color/user_orange"
                android:textSize="12sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/kingdomList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/clanList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="@string/decrees_header"
                        android:textColor="@color/user_orange"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:id="@+id/decreeGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:padding="4dp"
                        android:useDefaultMargins="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="التقنيات — ٧٠ اكتشافًا، اضغط أي صف لقراءة أثره"
                        android:textColor="@color/user_orange"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/techList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 5: powers -->
        <LinearLayout
            android:id="@+id/powersPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/powers_header"
                android:background="@drawable/bg_bar"
                android:textColor="@color/user_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <GridLayout
                        android:id="@+id/powerGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="5"
                        android:padding="4dp"
                        android:useDefaultMargins="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="الكوارث — ١٧ حدثًا، اضغط أيقونة لترسل الكارثة إلى الجزيرة"
                        android:textColor="#FFFF8A80"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:id="@+id/disasterGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="6"
                        android:padding="4dp"
                        android:useDefaultMargins="true" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 6: events -->
        <LinearLayout
            android:id="@+id/eventsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layoutDirection="rtl"
            android:visibility="gone">

            <!-- Island statistics live at the top of the events tab. -->
            <LinearLayout
                android:id="@+id/dockInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layoutDirection="rtl"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#FFFFF3E0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rulerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/user_orange"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <TextView
                        android:id="@+id/seasonText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/user_orange"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/dayProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/user_orange" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resourceStrip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_bar"
                    android:orientation="horizontal"
                    android:weightSum="6" />
            </LinearLayout>

            <TextView
                android:id="@+id/statText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="6"
                android:padding="5dp"
                android:textColor="#FFFFF3E0"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_bar"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/achievementList"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ListView
                android:id="@+id/eventsList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/user_brown"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Global tools: one flat, transparent strip that stays on every tab. -->
    <LinearLayout
        android:id="@+id/settingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl">

        <HorizontalScrollView
            android:id="@+id/dockToolsRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_bar"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="@dimen/title_text_max_width"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/title"
                    android:textColor="@color/user_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hintText"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/user_text_body"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/utilityBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <ImageButton
                        android:id="@+id/utilityInfoButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="@string/utility_info"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/utilitySettingsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="@string/utility_settings"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/pauseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="@string/pause"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/speedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="@string/speed"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/buildButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="@string/build_island"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/lawsCard"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <ImageButton
                        android:id="@+id/utilityModsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="@string/utility_mods"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Island-only tools: visibility is controlled by selectTab() in Java. -->
    <LinearLayout
        android:id="@+id/mapToolsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl">

        <LinearLayout
            android:id="@+id/dockMapToolsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layoutDirection="rtl">

            <HorizontalScrollView
                android:id="@+id/brushBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_bar"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <LinearLayout
                        android:id="@+id/overlayBar"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layoutDirection="rtl">

                        <ImageButton
                            android:id="@+id/overlayTerrainButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="طبقة التضاريس"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/overlayBiomeButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="طبقة الأحياء الحيوية"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/overlayKingdomButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="طبقة الممالك"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/overlayReligionButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="طبقة المعتقدات"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/overlayJobButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="طبقة المهن"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                    <View
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <ImageButton
                        android:id="@+id/brushInspectButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الفحص"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushWaterButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الماء"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushSandButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الرمل"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushGrassButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة العشب"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushForestButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الغابة"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushOrchardButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة البستان"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushMountainButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الجبل"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushCaveButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الكهف"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushHouseButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الكوخ"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushFarmButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة المزرعة"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushRoadButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة الطريق"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:id="@+id/humansCard"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layoutDirection="rtl">

                        <ImageButton
                            android:id="@+id/controlButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="@string/control"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/assassinateButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="@string/assassinate"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/brushHumanButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="فرشاة الإنسان"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/beastsCard"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layoutDirection="rtl">

                        <ImageButton
                            android:id="@+id/brushWolfButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_button"
                            android:contentDescription="فرشاة الذئب"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/brushFireButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة النار"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushRainButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة المطر"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/brushMeteorButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="فرشاة النيزك"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <ImageButton
                        android:id="@+id/zoomInButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="تكبير الخريطة"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/zoomOutButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="تصغير الخريطة"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/centerButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="توسيط الخريطة"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/gridButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_button"
                        android:contentDescription="إظهار أو إخفاء شبكة المربعات"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation: seven equal touch targets. -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_height"
        android:background="@color/user_dark"
        android:orientation="vertical"
        android:layoutDirection="rtl">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/user_brown" />

        <HorizontalScrollView
            android:id="@+id/dockNavRow"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_bar"
            android:scrollbars="horizontal">

            <LinearLayout
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="rtl">

                <ImageButton
                    android:id="@+id/navWorldButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="الجزيرة"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/navPeopleButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="السكان"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/navNatureButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="الطبيعة"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/navCreaturesButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="المخلوقات"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/navKingdomsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="الممالك"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/navPowersButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="القدرات"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/navEventsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="الأحداث"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
