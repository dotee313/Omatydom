<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1720"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="3"
        android:textColor="#FFCFD8DC"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/rulerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:textColor="#FFFFD54F"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/pauseButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/pause"
            android:padding="2dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/speedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/speed"
            android:padding="2dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/controlButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/control"
            android:padding="2dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/assassinateButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/assassinate"
            android:padding="2dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <TextView
        android:id="@+id/seasonText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FF90CAF9"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/dayProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progress="0" />

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/worldPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.dotee313.omatydom.android.IslandView
                android:id="@+id/islandView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="150dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/peoplePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/people_header"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/peopleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/decreesPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/decrees_header"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <GridLayout
                    android:id="@+id/decreeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="6dp"
                    android:useDefaultMargins="true" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eventsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ListView
                android:id="@+id/eventsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#FF37474F"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="#DD263238"
        android:ellipsize="end"
        android:maxLines="2"
        android:minHeight="38dp"
        android:padding="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="5dp"
        android:background="#FF1B2833"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/navWorldButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/nav_world"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/nav_world" />

        <ImageButton
            android:id="@+id/navPeopleButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/nav_people"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/nav_people" />

        <ImageButton
            android:id="@+id/navDecreesButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/nav_decrees"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/nav_decrees" />

        <ImageButton
            android:id="@+id/navEventsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/nav_events"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/nav_events" />
    </LinearLayout>

</LinearLayout>
